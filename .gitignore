# 不带尾斜杠：worktree 里常把 node_modules 软链到主检出目录，
# 带斜杠只匹配真目录，匹配不到符号链接，git status 会一直有噪音。
node_modules
dist/
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/uploads/*
!server/data/uploads/.gitkeep
.env
.DS_Store
tsconfig.tsbuildinfo
coverage/

# agent 工作用的临时 worktree
.claude/worktrees/

# 针对已部署环境的浏览器验证产物（截图与 trace）
e2e/deployed/.artifacts/
e2e/.tmp-data/
