# 复制成 .env 后填写（.env 不进 git）：cp .env.example .env

# ---- 镜像 ----
LOOP_IM_IMAGE=ghcr.io/cherrylover/loop-im
LOOP_IM_TAG=latest

# ---- 端口 ----
# 默认只绑定 127.0.0.1，建议前面用 Nginx/Caddy 终止 HTTPS
BIND_ADDRESS=127.0.0.1
HOST_PORT=4000

# ---- 必填 ----
# 生成：openssl rand -hex 32
JWT_SECRET=

# 首个管理员，只在该邮箱不存在时创建；之后改这里不会影响已有账号
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 附件对象存储（MinIO，随 compose 一起启停）----
# 桶不用手工建：程序启动时会自己检查并创建，还会跑一个读写来回自检（见 src/index.js）。
# ⚠️ 凭据只写在这个文件里（.env 不进 git）。留空跑一次 ./deploy.sh 会自动生成并写回来。
S3_BUCKET=loop-im
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# 切换期双读：MinIO 里没有的对象回落到本地磁盘（data/uploads）。
# 只有从旧版本升级上来、本地还留着老附件时才有意义；全部搬完并核对无误后设成 0。
UPLOADS_LOCAL_FALLBACK=1

# 想完全不用对象存储、附件就写本地磁盘：把 S3_BUCKET 留空即可（MinIO 容器仍会起，
# 只是没人用它；不想让它起就 `docker compose up -d loop-im`）。

# ---- 附件清理（默认关闭）----
# ⚠️ 这套清理会真的删文件，所以默认**不开**：程序层面不主动删用户数据，
#    桶涨多大交给运维侧的转存 / 备份去管。不配下面这行 = 一个字节都不删。
# 真要开就显式打开（on / true / 1 都认）：
# UPLOAD_ORPHAN_SWEEP=on
#
# 下面两项只在上面开了之后才有意义：
# 「传了但一直没发出去」的对象超过这么多小时就回收，默认 24
# UPLOAD_ORPHAN_TTL_HOURS=24
# 清理任务多久跑一轮（分钟），默认 60
# UPLOAD_SWEEP_INTERVAL_MINUTES=60
#
# 就算开着，这几类也一律不动：已经发出去的附件（正文里引着它）、头像、
# 以及库里查不到 attachments 记录的历史对象。

# 历史附件（库里查不到归属记录的老对象）的降级策略：authenticated（默认）| deny
# UPLOADS_LEGACY_ACCESS=authenticated

# ---- Web Push（iOS / Android 手机推送通知，默认关闭）----
# ⚠️ 不配下面三项 = 推送整体关闭，服务照常启动，其它功能一切照旧
#    （聊天、SSE、附件、桌面通知都不受影响，只是手机上不会响）。
#    三项必须一起配齐，缺一项也是整体关闭 —— 不会出现「订阅存下来了却永远推不出去」的半开状态。
#
# 生成（会打印可以直接粘到这里的三行，提示走 stderr，所以能直接重定向）：
#   docker compose run --rm loop-im node scripts/generate-vapid-keys.mjs
#
# ⚠️ 换 VAPID_PUBLIC_KEY = 所有已有订阅立即失效，每个用户都得在每台设备上重开一次通知。
#    详见 README「推送通知（Web Push）」。已经在用的环境不要重跑生成脚本。
#
# 三行都注释着 = 默认不开推送。要开就取消注释，把生成脚本吐出来的值填进去。
# （故意不留 `VAPID_PUBLIC_KEY=` 这样的空行：空值和「配了一半」在自检里是两种不同的状态，
#  留个空的公钥、填着下面的 subject，启动日志会报 partial_config，白白吓人一跳。）
# VAPID_PUBLIC_KEY=<生成脚本吐出来的 87 个字符，别手打>
# VAPID_PRIVATE_KEY=<生成脚本吐出来的 43 个字符，别手打，也别贴进工单和截图>
#
# VAPID_SUBJECT 必须是**真实域名**的 mailto: 邮箱或 https:// 网址。
# ⚠️ 写成 mailto:xxx@localhost（或内网域名、纯 IP）会被苹果的推送服务 403 BadJwtToken 拒掉 ——
#    症状是本地和安卓全绿、iPhone 一条都收不到。启动自检会直接拦下这种写法并说明原因。
# VAPID_SUBJECT=mailto:admin@your-domain.com

# ---- 可选 ----
# AI 成员显示名，默认 Aria
# AI_NAME=Aria

# 首次启动想直接带几个联系人（姓名:邮箱:部门，逗号分隔）
# DEMO_USERS=
# DEMO_PASSWORD=
