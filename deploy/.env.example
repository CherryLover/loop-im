# 复制成 .env 后填写（.env 不进 git）：cp .env.example .env

# ---- 镜像 ----
LOOP_IM_IMAGE=ghcr.io/cherrylover/loop-im
LOOP_IM_TAG=latest

# ---- 端口 ----
# 默认只绑定 127.0.0.1，建议前面用 Nginx/Caddy 终止 HTTPS
BIND_ADDRESS=127.0.0.1
HOST_PORT=4000

# ---- 必填 ----
# 生成：openssl rand -hex 32
JWT_SECRET=

# 首个管理员，只在该邮箱不存在时创建；之后改这里不会影响已有账号
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 可选 ----
# AI 成员显示名，默认 Aria
# AI_NAME=Aria

# 首次启动想直接带几个联系人（姓名:邮箱:部门，逗号分隔）
# DEMO_USERS=
# DEMO_PASSWORD=
