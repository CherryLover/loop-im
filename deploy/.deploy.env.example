# remote-deploy.sh 的连接信息。抄成同目录的 .deploy.env 再填 —— 那份不进 git。
# 本仓库是公开的，真实的地址 / 账号 / 密码只能待在 .deploy.env 里。

# 服务器地址与账号（必填）
DEPLOY_HOST=1.2.3.4
DEPLOY_USER=root
# SSH 端口，默认 22
#DEPLOY_PORT=22

# 密码登录才需要填（要求本机装 sshpass）；用密钥 / agent 的话留空或删掉这行
#DEPLOY_PASSWORD=

# 服务器上放 docker-compose.yml + deploy.sh 的目录（必填）
DEPLOY_DIR=/opt/loop-im

# 部署完从公网侧确认一次的健康接口；不填就跳过这步验证
HEALTH_URL=https://your-domain.example/api/health
