# 复制成 .env（.env 不会进 git），本地开发用
# cp .env.example .env

PORT=4000

# 签发登录 token 的密钥。生产环境必填，缺失时服务拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 首个管理员账号：只在该邮箱不存在时创建
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 本地想要一批联系人时填，格式 姓名:邮箱:部门，逗号分隔；留空则不创建
DEMO_USERS=
DEMO_PASSWORD=

# 加密落库的密钥，目前用于 AI 供应商的 API Key。留空则 Key 仍以明文存 SQLite
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 换掉这个值会导致已存的 Key 解不开，需要在「AI 配置」里重新填一次
ENCRYPTION_KEY=

# 跨域白名单，逗号分隔。默认部署是后端直接托管前端（同源），不需要填；
# 只有把前端单独部署到别的域名时才需要，例如 https://im.example.com
# 留空时：生产环境不发跨域头，非生产环境放开（不影响本地开发）
CORS_ORIGIN=

# 部署在 Nginx/Caddy 后面时填 1（或 loopback / 具体网段），否则按 IP 限流会把
# 所有请求都算成反代的 IP。前面没有反代时不要开，X-Forwarded-For 可被伪造
# TRUST_PROXY=1

# 登录失败限流：同一邮箱或同一 IP 在窗口内失败超过上限就暂时拒绝
# LOGIN_WINDOW_MS=900000
# LOGIN_MAX_FAILURES=10

# 已登录接口的用量限流：按用户维度，数的是「成功做成了几次」（和上面登录那套
# 「只数失败、成功清零」是两回事）。默认值按「正常人聊天撞不上」定，别随手调小
# RATE_MESSAGE_WINDOW_MS=60000
# RATE_MESSAGE_MAX=60
# @Aria 单独一档、而且更严：它每次都真实调用大模型，是唯一直接烧钱的接口
# RATE_AI_WINDOW_MS=300000
# RATE_AI_MAX=10
# 上传（聊天附件与头像共用同一档）
# RATE_UPLOAD_WINDOW_MS=60000
# RATE_UPLOAD_MAX=20
# 建群 / 加成员这类写接口
# RATE_WRITE_WINDOW_MS=60000
# RATE_WRITE_MAX=30

# 附件存储：留空用本地磁盘（server/data/uploads），配置后走 S3
# S3_BUCKET=
# S3_REGION=
