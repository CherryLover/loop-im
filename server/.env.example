# 复制成 .env（.env 不会进 git），本地开发用
# cp .env.example .env

PORT=4000

# 签发登录 token 的密钥。生产环境必填，缺失时服务拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 首个管理员账号：只在该邮箱不存在时创建
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 本地想要一批联系人时填，格式 姓名:邮箱:部门，逗号分隔；留空则不创建
DEMO_USERS=
DEMO_PASSWORD=

# AI 成员显示名，默认 Aria
# AI_NAME=Aria

# 附件存储：留空用本地磁盘（server/data/uploads），配置后走 S3
# S3_BUCKET=
# S3_REGION=

# AI Agent 调用地址（Codex 本地 Agent 可选）
# CODEX_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
